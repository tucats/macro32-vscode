          "match": "(?i)\\^D[0-9]+",
          "name": "constant.numeric.decimal.macro32"
        },
        {
          "match": "(?i)\\^F[0-9]*\\.?[0-9]*(?:E[+-]?[0-9]+)?",
          "name": "constant.numeric.float.macro32"
        },
        {
          "match": "(?i)\\^[MC]",
          "name": "keyword.operator.radix.macro32"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "(?i)(?<![A-Za-z0-9$._'])[0-9]+\\.[0-9]*(?:E[+-]?[0-9]+)?(?![A-Za-z0-9$_'])",
          "name": "constant.numeric.float.macro32"
        },
        {
          "match": "(?<![A-Za-z0-9$._'])[0-9]+(?![A-Za-z0-9$._'])",
          "name": "constant.numeric.integer.macro32"
        }
      ]
    },
    "local-labels": {
      "match": "(?<![A-Za-z0-9$._'])[0-9]+\\$(?![A-Za-z0-9$._])",
      "name": "entity.name.label.local.macro32"
    },
    "string-operators": {
      "match": "(?i)%(?:LENGTH|LOCATE|EXTRACT)\\b",
      "name": "support.function.string.macro32"
    },
    "symbols": {
      "match": "[A-Za-z$._][A-Za-z0-9$._]*",
      "name": "variable.other.symbol.macro32"
    },
    "operators": {
      "patterns": [
        {
          "match": "[#@]",
          "name": "keyword.operator.addressing.macro32"
        },
        {
          "match": "'",
          "name": "keyword.operator.concatenation.macro32"
        },
        {
          "match": "[?\\\\]",
          "name": "keyword.operator.macro.macro32"
        },
        {
          "match": "[-+*/&!]",
          "name": "keyword.operator.arithmetic.macro32"
        },
        {
          "match": "[()]",
          "name": "punctuation.section.parens.macro32"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.macro32"
        }
      ]
    }
  }
}
